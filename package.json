{
  "name": "@local/dsh-boot",
  "version": "1.0.2",
  "private": true,
  "description": "启动界面：游戏标题字 → 载入日志与进度 → 撕纸侧栏滑入 → 纸化开露出主界面；主界面带雪景底图、米色纸侧栏与像素胶囊。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "HANDOFF.md",
    "CREDITS.md",
    "licenses/",
    "packs/",
    "INSTALL.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "boot-animation",
    "splash",
    "startup",
    "theme",
    "web-ui",
    "pixel"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "dom:overlay",
      "browser:local-storage",
      "desktop:titlebar-overlay"
    ],
    "compatibility": {
      "dshVersions": [
        "0.2.0-rc.1"
      ]
    },
    "capability": {
      "id": "boot-splash",
      "kind": "ui",
      "invocation": "启动 desktop profile 后看首帧：document.querySelector('.dshb') 覆盖整个外壳并播放约 4.2s 的启动幕；结束后主界面侧栏由 [class*=\"_sidebarCol\"] 的纸面与像素胶囊构成，左下角落款是 #dshb-credit 里的游戏标题字。",
      "expected": "启动期间原生 [data-dsh-boot] 卡片被覆盖层挡住；4.2s 后覆盖层淡出，米色纸侧栏、六个像素胶囊（N/P/A/C/D/M）、雪景主栏与标题字落款一起出现。"
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "author": {
    "name": "深度求索皮肤（非盈利同人）",
    "url": "https://github.com/deepseek-ai"
  },
  "contributors": [
    {
      "name": "繁星相位制作组（《饲养染的 30 DAYS》）",
      "comment": "原作与制作组【繁星相位制作组】（《饲养染的 30 DAYS》/《终点站》）。按制作组条款：严禁对本素材包二次分发或搬运；严禁任何形式商业盈利；二创图片/视频需注明画师或制作组署名（示例见 CREDITS.md）。"
    },
    {
      "name": "赤橙chio",
      "comment": "画师：本文件夹内所有美术素材（立绘/SD/CG、雪景）均由画师【赤橙chio】绘制，画师保留对美术素材的解释与所有权。"
    },
    {
      "name": "TakWolf",
      "url": "https://takwolf.com",
      "comment": "Fusion Pixel 像素字体（SIL OFL-1.1，保留字体名 'Fusion Pixel'）。侧栏正文用 12px 版、胶囊用 10px 版，均为 GB2312 子集；许可证见 licenses/Fusion-Pixel-OFL-1.1.txt。"
    },
    {
      "name": "Ziyang Song",
      "url": "https://github.com/yannicksong0106",
      "comment": "dsh-550c-boot（MIT）：本包的 dsh / dshWorkshop 声明与 cordis.patch.yml 格式参考。"
    }
  ]
}
